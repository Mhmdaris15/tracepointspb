# ─── TracePoint SPB — Environment Variables ─────────────────────
# Copy this to .env and fill in your values.
# NEVER commit the .env file to version control.

# ─── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=trace_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=tracepoint_db

# ─── JWT Authentication ─────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_STRING

# ─── Yandex Maps API ────────────────────────────────────────────
YANDEX_MAPS_API_KEY=your_yandex_maps_api_key_here

# ─── Domain (for CORS & WebSocket connections) ──────────────────
DOMAIN=your-domain.com
